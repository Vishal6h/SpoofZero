# SpoofZero v1.0.0-rc1 - safe configuration template
# Copy to .env for local use. Never commit real keys or private paths.

# Runtime: local enables services selected below; demo disables all live services.
SPOOFZERO_MODE=local

# Local SQLite case store. Use an absolute path for managed/private deployments.
SPOOFZERO_CASE_DB=data/cases/spoofzero.sqlite3

# Store less personal metadata in new case snapshots by default.
SPOOFZERO_PRIVACY_SAFE_DEFAULT=false

# Master and per-service live intelligence switches.
SPOOFZERO_EXTERNAL_SERVICES_ENABLED=true
SPOOFZERO_VIRUSTOTAL_ENABLED=true
SPOOFZERO_DNS_ENABLED=true
SPOOFZERO_RDAP_ENABLED=true
SPOOFZERO_GEOLOCATION_ENABLED=true

# Optional VirusTotal key. Leave blank for UNKNOWN/UNAVAILABLE reputation results.
VT_API_KEY=

# Bounded request timeouts in seconds.
SPOOFZERO_VT_TIMEOUT_SECONDS=15
SPOOFZERO_DNS_TIMEOUT_SECONDS=3
SPOOFZERO_RDAP_TIMEOUT_SECONDS=8
SPOOFZERO_GEOLOCATION_TIMEOUT_SECONDS=10

# In-memory cache lifetimes in seconds.
SPOOFZERO_VT_CACHE_TTL_SECONDS=300
SPOOFZERO_DNS_CACHE_TTL_SECONDS=300
SPOOFZERO_RDAP_CACHE_TTL_SECONDS=900
SPOOFZERO_GEOLOCATION_CACHE_TTL_SECONDS=900
SPOOFZERO_FAILURE_CACHE_TTL_SECONDS=20
